# Base public RPCs are rate-limited. Use a dedicated provider for production.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_MAINNET_RPC_URL=https://mainnet.base.org

# Etherscan API V2 key used to verify contracts on Base.
ETHERSCAN_API_KEY=

# Operator that will own PawfundFactory. Do not use the zero address.
PAWFUND_INITIAL_OWNER=<OPERATOR_WALLET_ADDRESS>
